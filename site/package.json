{
  "name": "universe-docs-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "predev": "pnpm sync",
    "dev": "astro dev",
    "prebuild": "pnpm sync",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "test": "node --test",
    "deploy": "pnpm build && wrangler deploy",
    "check": "pnpm build && node scripts/check-dist.mjs && pnpm test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "wrangler": "^4.156.2"
  }
}
